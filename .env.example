# Supabase (Settings → API in Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key

# Optional
ADMIN_HOST=admin.localhost:3000
GROQ_API_KEY=

# Optional: override app URL for magic links (Vercel sets VERCEL_URL automatically)
# PUBLIC_APP_URL=https://your-app.vercel.app
